	vdtl_openitem.VoucherDtlOID,-- 财务凭证未清明细表 财务凭证OID
	vdtl_openitem.BaselineDate AS OpenItemBaselineDate,-- 财务凭证未清明细表 基准日期
	vdtl_openitem.VoucherClearStatus AS VoucherClearStatus,-- 财务凭证未清明细表 凭证清账状态
	vdtl_openitem.ClearStatus AS OpenItemClearStatus,-- 财务凭证未清明细表 清账状态
	vdtl_openitem.Money AS OpenItemMoney,-- 财务凭证未清明细表 应收金额
	vdtl_openitem.CurrencyID AS OpenItemCurrencyID,-- 财务凭证未清明细表 币种
	vdtl_openitem.FirstLocalCurrencyID AS OpenItemFirstLocalCurrencyID,-- 财务凭证未清明细表 本位币
	vdtl_openitem.FirstLocalCryMoney AS OpenItemFirstLocalCryMoney,-- 财务凭证未清明细表 本位币金额
	vdtl_openitem.ClearMoney AS OpenItemClearMoney,-- 财务凭证未清明细表 已清原币金额
	vdtl_openitem.ClearFirstLocalCryMoney AS OpenItemClearFirstLocalCryMoney -- 财务凭证未清明细表 已清本位币金额
FROM
	ESD_SaleBillingDtl Billingdtl
	INNER JOIN ESD_SaleBillingHead Billinghead ON Billingdtl.soid = Billinghead.soid
	Left join ESD_SB_ConditionTypeValue BillingCon on Billingdtl.soid=BillingCon.soid and Billingdtl.oid=BillingCon.poid
	INNER JOIN esd_saleorderdtl dr ON dr.soid = Billingdtl.SrcSOID 
	AND dr.oid = Billingdtl.SrcOID
	INNER JOIN esd_saleorderhead hr ON hr.soid = dr.soid
	Left join ESD_SO_ConditionTypeValue saleCon on dr.soid=saleCon.soid and dr.oid=saleCon.poid
	LEFT JOIN bk_Material m ON dr.MaterialID = m.OID
	LEFT JOIN ESD_CustomerHierarchy ch ON hr.ShipToPartyID = ch.CustomerID 
	AND hr.SaleOrganizationID = ch.SaleOrganizationID 
	AND hr.DistributionChannelID = ch.DistributionChannelID 
	AND hr.DivisionID = ch.DivisionID 
	AND hr.SaleOrganizationID = ch.HigherSaleOrganizationID 
	AND hr.DistributionChannelID = ch.HigherDistributionChannelID 
	AND hr.DivisionID = ch.HigherDivisionID 
	AND hr.PricingDate >= ch.ValidStartDate 
	AND hr.PricingDate <= ch.ValidEndDate -- TODO 这里存在>=、<=等符号，需要确认是否支持
	LEFT JOIN efi_voucherdtl_openitem vdtl_openitem ON Billingdtl.oid = vdtl_openitem.srcoid
	
